# Check if any relevant files have changed
if git diff --cached --name-only | grep -q "packages/deployment/config/index.json\|packages/deployment/ignition/deployments/chain-.*/deployed_addresses.json"; then
  echo "Deployment config or addresses changed, syncing to gov validator..."
  cd packages/summer-earn-gov-validator
  npm run sync-config
  git add src/config/
  cd ..
  cd summer-earn-interface
  npm run sync-config
  git add src/config/
fi