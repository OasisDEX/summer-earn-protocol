{
  "name": "@summerfi/tenderly-utils",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "tsc": "tsc",
    "watch": "tsc -w",
    "test": "jest tests/ --passWithNoTests",
    "testw": "jest --watch",
    "e2e": "jest e2e/",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "format:fix": "prettier --write \"**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "build": "tsc -b -v tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json  -w"
  },
  "dependencies": {
    "@inquirer/prompts": "4.3.3",
    "typescript": "5.4.5"
  },
  "devDependencies": {
    "@ethersproject/providers": "5.7.2",
    "@summerfi/eslint-config": "workspace:*",
    "@summerfi/jest-config": "workspace:*",
    "@summerfi/typescript-config": "workspace:*",
    "eslint": "^9.0.0",
    "axios": "1.15.2",
    "ethers": "6.11.1"
  }
}
