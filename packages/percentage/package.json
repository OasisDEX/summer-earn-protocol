{
  "name": "@summerfi/percentage-solidity",
  "description": "Percentage library",
  "version": "1.0.0",
  "dependencies": {
    "solhint-plugin-prettier": "0.1.0"
  },
  "devDependencies": {
    "@summerfi/eslint-config": "workspace:*",
    "@summerfi/jest-config": "workspace:*",
    "@summerfi/tenderly-utils": "workspace:*",
    "@summerfi/typescript-config": "workspace:*",
    "@summerfi/dependencies": "workspace:*",
    "forge-std": "github:foundry-rs/forge-std#v1.8.1",
    "prettier": "3.0.0",
    "solhint": "3.6.2"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "forge",
    "foundry",
    "smart-contracts",
    "solidity"
  ],
  "private": true,
  "scripts": {
    "clean": "rm -rf cache out",
    "build": "forge build --quiet",
    "format": "prettier --check \"**/*.sol\" --no-error-on-unmatched-pattern --ignore-path \".prettierignore\"",
    "format:fix": "prettier --write \"**/*.sol\" --no-error-on-unmatched-pattern --ignore-path \".prettierignore\"",
    "test": "forge test",
    "test:coverage": "forge coverage",
    "test:coverage:report": "forge coverage --ir-minimum --report lcov && genhtml lcov.info --branch-coverage --output-dir coverage"
  }
}
