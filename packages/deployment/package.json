    "verify:arbitrum": "hardhat ignition verify chain-42161",
    "verify:unichain": "hardhat ignition verify chain-130",
    "verify:optimism": "hardhat ignition verify chain-10",
    "verify:base": "hardhat ignition verify chain-8453",
    "verify:sonic": "hardhat ignition verify chain-146",
    "verify:hyperliquid": "hardhat ignition verify chain-999",
    "verify:all": "pnpm verify:mainnet && pnpm verify:arbitrum && pnpm verify:base && pnpm verify:sonic && pnpm verify:hyperliquid",
    "visualize:core": "hardhat ignition visualize ./ignition/modules/fleet.ts",
    "create-distributions-tx": "hardhat run scripts/governance/create-distributions-transaction-safe.ts --network $NETWORK",
    "whitelist-vesting-wallets-tx": "hardhat run scripts/governance/whitelist-vesting-wallets-safe.ts --network $NETWORK",
    "generate-merkle-root": "tsx scripts/generate-merkle-root.ts",
    "update-fleet-configurations": "tsx scripts/governance/update-fleet-configurations-safe.ts",
    "configure-bummer-fleets-test": "hardhat run scripts/governance/configure-bummer-fleets-test.ts --network $NETWORK",
    "update-non-sweepable-tokens": "tsx scripts/governance/set-non-sweepable-tokens-proposal.ts",
    "configure:new-chain-layerzero": "hardhat run scripts/bridge/configure-new-chain-lz.ts --network $NETWORK --no-compile",
    "gov:submit-proposal": "hardhat run scripts/governance/submit-proposal.ts --network $NETWORK",
    "gov:test-transfer-bummer-tokens": "hardhat run scripts/governance/test-transfer-bummer-tokens.ts --network $NETWORK",
    "gov:execute-proposal": "hardhat run scripts/governance/execute-proposal.ts --network $NETWORK",
    "gov:execute-proposal:direct": "hardhat run scripts/governance/execute-proposal-direct.ts --network $NETWORK",
    "gov:create-fleet-rewards-proposals": "hardhat run scripts/governance/create-fleet-rewards-proposals.ts --network $NETWORK",
    "gov:enable-fleet-transferability": "hardhat run scripts/governance/enable-fleet-transferability-proposal.ts --network $NETWORK",
    "gov:setup-foundation-roles": "hardhat run scripts/governance/setup-foundation-roles.ts --network $NETWORK",
    "gov:merge-proposals": "hardhat run scripts/merge-proposals.ts --network mainnet",
    "gov-v2:add-vesting-factories": "hardhat run scripts/governance/gov-v2-setup/add-vesting-factories-safe.ts --network $NETWORK",
    "gov-v2:add-token-whitelist": "hardhat run scripts/governance/gov-v2-setup/add-token-whitelist-safe.ts --network $NETWORK",
    "gov-v2:add-staking-caps": "hardhat run scripts/governance/gov-v2-setup/add-staking-caps-safe.ts --network $NETWORK",
    "gov-v2:schedule-token-approval": "hardhat run scripts/governance/gov-v2-setup/schedule-token-approval-safe.ts --network $NETWORK",
    "gov-v2:schedule-token-transfers": "hardhat run scripts/governance/gov-v2-setup/schedule-token-transfers-safe.ts --network $NETWORK",
    "gov-v2:schedule-summer-staking-reward-batch": "hardhat run scripts/governance/gov-v2-setup/schedule-summer-staking-reward-batch-safe.ts --network $NETWORK",
    "update-vesting-goals": "hardhat run scripts/governance/update-vesting-goals-safe.ts --network $NETWORK",
    "check-morpho-rewards": "tsx scripts/check-morpho-rewards.ts",
    "check-angl-rewards": "tsx scripts/check-angl-rewards.ts",
    "gov:create-multi-chain-transfer-proposal": "hardhat run scripts/governance/create-multi-chain-transfer-proposal.ts --network $NETWORK",
    "gov:create-guardian-role-proposal": "hardhat run scripts/governance/create-guardian-role-proposal.ts --network $NETWORK",
    "gov:convert-gov-proposal-to-safe-tx": "tsx scripts/governance/convert-gov-proposal-to-safe-tx.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@layerzerolabs/lz-v2-utilities": "2.3.39",
    "@nomicfoundation/hardhat-foundry": "1.2.0",
    "@nomicfoundation/hardhat-ignition": "0.15.15",
    "@nomicfoundation/hardhat-ignition-viem": "0.15.15",
    "@nomicfoundation/hardhat-viem": "2.1.3",
    "@nomicfoundation/hardhat-verify": "2.1.1",
    "@summerfi/access-contracts": "workspace:*",
    "@summerfi/config-contracts": "workspace:*",
    "@summerfi/chain-bridge-contracts": "workspace:*",
