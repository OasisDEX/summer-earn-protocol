# --- RPC + signer ---
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
KEEPER_PRIVATE_KEY=0x...                              # SUPER_KEEPER_ROLE-holding EOA

# --- Protocol addresses ---
DCA_STRATEGY_MANAGER=0x0000000000000000000000000000000000000000

# --- Subgraph ---
SUBGRAPH_URL=https://api.goldsky.com/api/public/project_<id>/subgraphs/summer-dca-base/<version>/gn

# --- Enso ---
ENSO_API_URL=https://api.enso.finance/api/v1
ENSO_API_KEY=                                         # optional; some routes work unauthenticated, prod keys raise rate limits

# --- Loop / gas tuning ---
POLL_INTERVAL_SECONDS=30
MAX_CONCURRENT_EXECUTIONS=3
MAX_FEE_PER_GAS_CAP_GWEI=100                          # hard ceiling — strategy will be skipped if base*2+tip would exceed this
PRIORITY_FEE_GWEI=1
TX_CONFIRMATION_TIMEOUT_SECONDS=180
