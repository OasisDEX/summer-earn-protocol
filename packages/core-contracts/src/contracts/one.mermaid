graph TD
    subgraph "Current Architecture: State Read Based"
        subgraph "Hub Chain Operations"
            A1[1. User deposits to CrossChainArk]
            A2[2. CrossChainArk.inflightAssets += amount]
            A3[3. Bridge assets to FleetProxy]
            A4[4. Manual balance sync needed]
            A5[5. CrossChainArk.requestRemoteAssetBalanceUpdate]
            A6[6. LayerZero state read: FleetProxy.totalAssets]
            A7[7. Update lastRemoteAssetBalance, reset inflightAssets]
        end
        
        subgraph "Satellite Chain Operations"
            B1[FleetProxy receives assets]
            B2[FleetProxy deposits to Fleet]
            B3[FleetProxy.totalAssets = Fleet + inflightWithdrawals]
            B4[Responds to state read requests]
        end
        
        A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7
        A3 -.-> B1 --> B2
        A6 -.-> B3 --> B4 -.-> A7
    end

    subgraph "Proposed Architecture: Message Based"
        subgraph "Hub Chain Operations - New"
            C1[1. User deposits to CrossChainArk]
            C2[2. CrossChainArk.inflightAssets += amount]
            C3[3. Bridge assets to FleetProxy]
            C4[4. Automatic balance update received]
            C5[5. CrossChainArk.receiveMessage - BalanceUpdate]
            C6[6. Validate timestamp/nonce, update balance]
            C7[7. Reset inflightAssets automatically]
        end
        
        subgraph "Satellite Chain Operations - New"
            D1[FleetProxy receives assets]
            D2[FleetProxy deposits to Fleet]
            D3[FleetProxy calculates new balance]
            D4[FleetProxy.sendBalanceUpdate message]
            D5[Periodic balance sync via keeper/timer]
        end
        
        C1 --> C2 --> C3 --> C4 --> C5 --> C6 --> C7
        C3 -.-> D1 --> D2 --> D3 --> D4 -.-> C4
        D5 -.-> D4
    end

    subgraph "Implementation Details"
        subgraph "Current State Read Details"
            E1["🔍 State Read Process:<br/>• Manual trigger required<br/>• executeReadState call<br/>• LayerZero read fees<br/>• Complex error handling<br/>• Sync delays possible"]
            
            E2["📊 Balance Calculation:<br/>totalAssets = localBalance +<br/>lastRemoteAssetBalance +<br/>inflightAssets"]
            
            E3["⚠️ Edge Cases:<br/>• Read timeouts<br/>• Invalid responses<br/>• Network congestion<br/>• Manual intervention needed"]
        end
        
        subgraph "Proposed Message Details"
            F1["📨 Message Process:<br/>• Event-driven automatic<br/>• executeSendMessage call<br/>• Standard message fees<br/>• Simple error handling<br/>• Real-time updates"]
            
            F2["📊 Balance Message:<br/>struct BalanceUpdate {<br/>  uint256 balance<br/>  uint256 timestamp<br/>  uint256 nonce<br/>}"]
            
            F3["✅ Benefits:<br/>• Automatic sync<br/>• Lower costs<br/>• Better reliability<br/>• Event-driven<br/>• Self-healing"]
        end
    end

    subgraph "Key Technical Differences"
        G1["🏗️ CrossChainArk Changes:<br/>• Remove requestRemoteAssetBalanceUpdate<br/>• Add receiveMessage for BalanceUpdate<br/>• Add timestamp/nonce validation<br/>• Simplify balance tracking logic"]
        
        G2["🔧 FleetProxy Changes:<br/>• Add sendBalanceUpdate function<br/>• Add automatic trigger on deposits<br/>• Add periodic sync mechanism<br/>• Add balance update message struct"]
        
        G3["⚙️ Operational Changes:<br/>• No manual balance sync needed<br/>• Reduced keeper complexity<br/>• Automatic error recovery<br/>• Real-time balance updates"]
    end

    %% Styling
    classDef current fill:#ffe6e6,stroke:#ff4444,stroke-width:2px
    classDef proposed fill:#e6ffe6,stroke:#44ff44,stroke-width:2px
    classDef technical fill:#e6f3ff,stroke:#0066cc,stroke-width:2px
    classDef benefits fill:#fff2e6,stroke:#ff9900,stroke-width:2px

    class A1,A2,A3,A4,A5,A6,A7,B1,B2,B3,B4,E1,E2,E3 current
    class C1,C2,C3,C4,C5,C6,C7,D1,D2,D3,D4,D5,F1,F2,F3 proposed
    class G1,G2,G3 technical