{
  "name": "summer-earn-interface",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check \"**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "format:fix": "prettier --write \"**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "sync-config": "node scripts/sync-config.mjs",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "sst:dev": "AWS_PROFILE=gov-validator-aws sst dev",
    "sst:deploy": "AWS_PROFILE=gov-validator-aws sst deploy"
  },
  "dependencies": {
    "@halaprix/domino": "1.3.0",
    "@reown/appkit": "1.8.19",
    "@reown/appkit-adapter-wagmi": "1.8.19",
    "@tanstack/react-query": "^5.76.1",
    "@wagmi/core": "3.4.0",
    "next": "16.2.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^2.15.3",
    "sonner": "^2.0.7",
    "viem": "^2.41.2",
    "wagmi": "3.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1030.0",
    "@aws-sdk/client-ssm": "^3.1030.0",
    "@aws-sdk/lib-dynamodb": "^3.1030.0",
    "@eslint/eslintrc": "^3.0.0",
    "@summerfi/jest-config": "workspace:*",
    "@types/jest": "29.5.12",
    "@types/node": "^20",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.6",
    "glob": "^13.0.6",
    "jest": "29.7.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "ts-jest": "29.1.2",
    "typescript": "^5",
    "sst": "^4.17.1"
  }
