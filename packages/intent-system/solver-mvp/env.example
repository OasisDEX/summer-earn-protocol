# Summer Earn Intent Solver Environment Variables
# Copy this file to .env and fill in your values

# Your private key (without 0x prefix)
# WARNING: Never commit your actual private key to version control!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Optional: Custom RPC URL (defaults to Base mainnet)
# RPC_URL=https://mainnet.base.org

# Optional: Custom gas price (in wei, defaults to network gas price)
# GAS_PRICE=20000000000
