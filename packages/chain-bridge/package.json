{
  "name": "@summerfi/chain-bridge-contracts",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "forge build --skip 'test'",
    "test": "FOUNDRY_PROFILE=test forge test",
    "coverage": "FOUNDRY_PROFILE=test forge coverage --ir-minimum",
    "coverage:lcov": "FOUNDRY_PROFILE=test forge coverage --report lcov --ir-minimum",
    "coverage:report": "pnpm coverage:lcov && genhtml -o coverage --branch-coverage lcov.info"
  },
  "dependencies": {
    "@layerzerolabs/toolbox-foundry": "0.1.12",
    "@stargatefinance/stg-evm-v2": "^2.0.5",
    "@summerfi/access-contracts": "workspace:*",
    "@summerfi/dependencies": "workspace:*",
    "solidity-bytes-utils": "0.8.2"
  }
}
