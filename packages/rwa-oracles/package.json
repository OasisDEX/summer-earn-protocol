{
  "name": "@summerfi/rwa-oracles",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "coverage": "forge coverage --ir-minimum",
    "coverage:lcov": "forge coverage --report lcov --ir-minimum",
    "coverage:report": "pnpm coverage:lcov && genhtml -o coverage --branch-coverage lcov.info",
    "format": "prettier --check \"**/*.sol\" --no-error-on-unmatched-pattern",
    "format:fix": "prettier --write \"**/*.sol\" --no-error-on-unmatched-pattern",
    "docs:gen": "forge doc"
  },
  "dependencies": {
    "@summerfi/dependencies": "workspace:*"
  }
}
