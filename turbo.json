{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "MAINNET_RPC_URL",
    "ARBITRUM_RPC_URL",
    "BASE_RPC_URL",
    "SONIC_RPC_URL",
    "OPTIMISM_RPC_URL",
    "HYPERLIQUID_RPC_URL",
    "FOUNDRY_FUZZ_RUNS",
    "ETHERSCAN_API_KEY"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "prebuild": {
      "dependsOn": [
        "^prebuild",
        "^prebuild:nocache"
      ],
      "outputs": [
        "src/types/graphql/generated.ts",
        "src/generated"
      ]
    },
    "prebuild:nocache": {
      "dependsOn": [
        "^prebuild:nocache"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": [
        "prebuild",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "artifacts/**",
        "out/**",
        "cache_forge/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^prebuild"
      ],
      "inputs": [
        "src/**/*.sol",
        "test/**/*.sol",
        "foundry.toml",
        "package.json"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [
        "prebuild",
        "build",
        "^test:integration"
      ]
    },
    "lint": {
      "dependsOn": [
        "prebuild"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "prebuild",
        "build",
        "^lint:fix"
      ],
      "cache": false
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "format:fix": {
      "dependsOn": [
        "^format:fix"
      ],
      "cache": false
    },
    "check-circular": {
      "dependsOn": [
        "prebuild",
        "build",
        "^check-circular"
      ]
    },
    "cicheck": {
      "dependsOn": [
        "prebuild",
        "build",
        "test",
        "test:integration",
        "lint",
        "check-circular",
        "format"
      ]
    },
    "deploy:staging": {
      "dependsOn": [
        "cicheck",
        "^deploy:staging"
      ]
    },
    "coverage": {
      "dependsOn": [
        "^prebuild"
      ]
    },
    "coverage:lcov": {
      "dependsOn": [
        "^prebuild"
      ],
      "inputs": [
        "src/**/*.sol",
        "test/**/*.sol",
        "foundry.toml",
        "package.json"
      ],
      "outputs": []
    }
  },
  "futureFlags": {
    "errorsOnlyShowHash": true
  }
}